{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "paths": {
      "@/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "../sdk/*.ts",
    "tipos/node-crypto.d.ts"
  ]
}