{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/lib/browser": [
        "./tipos/browser-modulo.d.ts"
      ],
      "@/*": [
        "../src/*"
      ]
    },
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": [
    "../src/**/*.tsx",
    "../src/**/*.ts",
    "tipos/*.d.ts"
  ]
}